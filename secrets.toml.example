# Copy to .streamlit/secrets.toml for local use, or paste into Streamlit Cloud -> Settings -> Secrets
# Both values are OPTIONAL. Without them the app works, only the watsonx.ai button is hidden.
WATSONX_API_KEY = "your-ibm-cloud-api-key"
WATSONX_PROJECT_ID = "your-watsonx-project-id"
WATSONX_URL = "https://eu-de.ml.cloud.ibm.com"
